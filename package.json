{
  "name": "neuton-server",
  "version": "1.0.0",
  "private": true,
  "description": "Neuton — Kitchen & Business Management API (NestJS/Express + Drizzle + Supabase + BullMQ + R2)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "verify": "npm run typecheck && npm run typecheck:test && npm test && npm run build",
    "test": "tsx --test scripts/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:validate": "tsx scripts/validate-migrations.ts",
    "db:verify-rls": "tsx scripts/verify-rls.ts",
    "db:mark-applied": "tsx scripts/mark-applied.ts",
    "test:integrations": "tsx scripts/test-redis.ts && tsx scripts/test-upload-flow.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@google/genai": "^1.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@supabase/supabase-js": "^2.47.10",
    "bullmq": "^5.34.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-loki": "^3.0.0",
    "postgres": "^3.4.5",
    "proper-lockfile": "^4.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "libpg-query": "^18.1.5",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
