{
  "name": "neuton-server",
  "version": "1.0.0",
  "private": true,
  "description": "Neuton — Kitchen & Business Management API (NestJS/Express + Drizzle + Neon + BullMQ + R2)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "verify": "npm run typecheck && npm run typecheck:test && npm test && npm run build",
    "test": "tsx --tsconfig tsconfig.test.json --test scripts/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:provision": "tsx scripts/provision-neon-roles.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:validate": "tsx scripts/validate-migrations.ts",
    "db:verify-rls": "tsx scripts/verify-rls.ts",
    "account:disable": "tsx scripts/disable-account.ts",
    "test:integrations": "tsx scripts/test-redis.ts && tsx scripts/test-upload-flow.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@google/genai": "^1.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "argon2": "0.45.2",
    "bullmq": "^5.34.6",
    "cookie": "2.0.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.9",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-loki": "^3.0.0",
    "postgres": "4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "libpg-query": "^18.1.5",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
